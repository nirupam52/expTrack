{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test:currency": "node --experimental-strip-types --test src/lib/utils/format-currency.test.ts",
		"test:utils": "node --experimental-strip-types --test src/lib/utils/*.test.ts"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "~7.0.1",
		"@sveltejs/adapter-static": "~3.0.10",
		"@sveltejs/kit": "~2.70.2",
		"@sveltejs/vite-plugin-svelte": "~7.1.2",
		"@tailwindcss/vite": "~4.3.0",
		"@types/node": "~24.0.0",
		"svelte": "~5.56.1",
		"svelte-check": "~4.6.0",
		"tailwindcss": "~4.3.0",
		"typescript": "~6.0.3",
		"vite": "~8.0.16"
	},
	"dependencies": {
		"zod": "^4.4.3"
	}
}
